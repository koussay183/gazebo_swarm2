<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mappo_swarm_bringup</name>
  <version>0.1.0</version>
  <description>
    System bringup and orchestration package for MAPPO multi-agent drone swarm.
    Provides top-level launch files, PX4 SITL startup scripts, and system
    check utilities for end-to-end swarm deployment.
  </description>
  <maintainer email="web@slamatravel.com">koussay183</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>mappo_swarm_core</depend>
  <depend>mappo_swarm_px4</depend>
  <depend>mappo_swarm_bridge</depend>
  <depend>mappo_swarm_gcs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
