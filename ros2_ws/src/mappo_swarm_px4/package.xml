<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mappo_swarm_px4</name>
  <version>0.1.0</version>
  <description>
    PX4 offboard control integration for MAPPO multi-agent drone swarm.
    Provides ROS 2 nodes for RL-based drone control via PX4 uXRCE-DDS bridge,
    offboard control management, state listening, and diagnostics.
  </description>
  <maintainer email="web@slamatravel.com">koussay183</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>mappo_swarm_core</depend>

  <exec_depend>python3-torch</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
