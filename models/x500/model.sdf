<?xml version="1.0" ?>
<!--
  Holybro x500 v2 – Modèle réel pour PX4 SITL (Gazebo Harmonic)
  ==============================================================
  Spécifications réelles :
    Wheelbase      : 500 mm (moteur-à-moteur en diagonale)
    Empattement XY : 175 mm depuis le centre (500/2 × sin45°)
    Masse AUW      : 2.0 kg
    Moteurs        : 4× 2216 880 KV brushless
    Hélices        : 10×4.5 pouces (254 mm diamètre)
    Batterie       : 4S LiPo

  Physique réelle (MulticopterMotorModel) :
    motorConstant         : 8.54858e-06  N·s²/rad²
    momentConstant        : 0.016754     (couple de traînée/poussée)
    maxRotorVelocity      : 1000 rad/s
    rotorDragCoefficient  : 8.06428e-05

  Architecture liens :
    base_link  — corps principal (geometrie + capteurs)
    rotor_0    — avant-droit  (CCW)  joint rotor_0_joint
    rotor_1    — arrière-gauche (CCW) joint rotor_1_joint
    rotor_2    — avant-gauche (CW)   joint rotor_2_joint
    rotor_3    — arrière-droit (CW)  joint rotor_3_joint

  Plugins PX4 :
    MulticopterMotorModel × 4 — physique moteurs (lus par PX4 via gz-transport)
    IMU / GPS / Baro sensors   — télémétrie PX4
    PosePublisher              — retour position ROS2 (MAVROS fallback)
-->
<sdf version="1.9">
<model name="x500">

  <!-- ═══════════════════════════════════════════════════════════════
       CORPS PRINCIPAL (base_link)
       Masse, inertie, géométrie visuelle et capteurs embarqués.
       gravity=true → physique réelle, PX4 gère la sustentation.
       ═══════════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <gravity>true</gravity>

    <inertial>
      <!-- Holybro x500 v2 – valeurs mesurées par PX4 development team -->
      <mass>2.0</mass>
      <inertia>
        <ixx>0.0347563</ixx>
        <iyy>0.0458929</iyy>
        <izz>0.0977</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
      </inertia>
    </inertial>

    <!-- Boîte englobante pour collisions -->
    <collision name="base_collision">
      <geometry><box><size>0.50 0.50 0.18</size></box></geometry>
    </collision>

    <!-- ─── PLAQUES CENTRALES (carbon fiber) ───────────────────── -->
    <visual name="top_plate">
      <pose>0 0 0.025 0 0 0.7854</pose>
      <geometry><cylinder><radius>0.090</radius><length>0.008</length></cylinder></geometry>
      <material>
        <ambient>0.06 0.06 0.06 1</ambient>
        <diffuse>0.10 0.10 0.10 1</diffuse>
        <specular>0.7 0.7 0.7 1</specular>
      </material>
    </visual>
    <visual name="bottom_plate">
      <pose>0 0 -0.015 0 0 0.7854</pose>
      <geometry><cylinder><radius>0.090</radius><length>0.006</length></cylinder></geometry>
      <material>
        <ambient>0.06 0.06 0.06 1</ambient>
        <diffuse>0.10 0.10 0.10 1</diffuse>
        <specular>0.7 0.7 0.7 1</specular>
      </material>
    </visual>
    <visual name="center_column">
      <pose>0 0 0.005 0 0 0</pose>
      <geometry><cylinder><radius>0.025</radius><length>0.045</length></cylinder></geometry>
      <material>
        <ambient>0.15 0.15 0.15 1</ambient>
        <diffuse>0.20 0.20 0.20 1</diffuse>
      </material>
    </visual>

    <!-- ─── BRAS X-FRAME (4 bras carbone, configuration X) ──────── -->
    <!-- Bras Avant-Droit -->
    <visual name="arm_FR">
      <pose>0.088 -0.088 0.002 0 0 -0.7854</pose>
      <geometry><cylinder><radius>0.014</radius><length>0.300</length></cylinder></geometry>
      <material><ambient>0.75 0.28 0.0 1</ambient><diffuse>0.90 0.38 0.0 1</diffuse></material>
    </visual>
    <!-- Bras Avant-Gauche -->
    <visual name="arm_FL">
      <pose>0.088 0.088 0.002 0 0 0.7854</pose>
      <geometry><cylinder><radius>0.014</radius><length>0.300</length></cylinder></geometry>
      <material><ambient>0.75 0.28 0.0 1</ambient><diffuse>0.90 0.38 0.0 1</diffuse></material>
    </visual>
    <!-- Bras Arrière-Droit -->
    <visual name="arm_RR">
      <pose>-0.088 -0.088 0.002 0 0 0.7854</pose>
      <geometry><cylinder><radius>0.014</radius><length>0.300</length></cylinder></geometry>
      <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material>
    </visual>
    <!-- Bras Arrière-Gauche -->
    <visual name="arm_RL">
      <pose>-0.088 0.088 0.002 0 0 -0.7854</pose>
      <geometry><cylinder><radius>0.014</radius><length>0.300</length></cylinder></geometry>
      <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.14 0.14 0.14 1</diffuse></material>
    </visual>

    <!-- ─── MOTEURS 2216 880KV (4×) ─────────────────────────────── -->
    <!-- MOTEUR Avant-Droit (CCW, rouge) -->
    <visual name="motor_FR_stator">
      <pose>0.175 -0.175 -0.005 0 0 0</pose>
      <geometry><cylinder><radius>0.019</radius><length>0.024</length></cylinder></geometry>
      <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
    </visual>
    <visual name="motor_FR_bell">
      <pose>0.175 -0.175 0.015 0 0 0</pose>
      <geometry><cylinder><radius>0.017</radius><length>0.020</length></cylinder></geometry>
      <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material>
    </visual>
    <!-- MOTEUR Avant-Gauche (CW, rouge) -->
    <visual name="motor_FL_stator">
      <pose>0.175 0.175 -0.005 0 0 0</pose>
      <geometry><cylinder><radius>0.019</radius><length>0.024</length></cylinder></geometry>
      <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
    </visual>
    <visual name="motor_FL_bell">
      <pose>0.175 0.175 0.015 0 0 0</pose>
      <geometry><cylinder><radius>0.017</radius><length>0.020</length></cylinder></geometry>
      <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material>
    </visual>
    <!-- MOTEUR Arrière-Droit (CW, noir) -->
    <visual name="motor_RR_stator">
      <pose>-0.175 -0.175 -0.005 0 0 0</pose>
      <geometry><cylinder><radius>0.019</radius><length>0.024</length></cylinder></geometry>
      <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
    </visual>
    <visual name="motor_RR_bell">
      <pose>-0.175 -0.175 0.015 0 0 0</pose>
      <geometry><cylinder><radius>0.017</radius><length>0.020</length></cylinder></geometry>
      <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
    </visual>
    <!-- MOTEUR Arrière-Gauche (CCW, noir) -->
    <visual name="motor_RL_stator">
      <pose>-0.175 0.175 -0.005 0 0 0</pose>
      <geometry><cylinder><radius>0.019</radius><length>0.024</length></cylinder></geometry>
      <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
    </visual>
    <visual name="motor_RL_bell">
      <pose>-0.175 0.175 0.015 0 0 0</pose>
      <geometry><cylinder><radius>0.017</radius><length>0.020</length></cylinder></geometry>
      <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
    </visual>

    <!-- ─── ÉLECTRONIQUE ─────────────────────────────────────────── -->
    <!-- Pixhawk 6C (flight controller) -->
    <visual name="fc_pixhawk">
      <pose>0 0 0.033 0 0 0</pose>
      <geometry><box><size>0.052 0.042 0.016</size></box></geometry>
      <material><ambient>0.1 0.2 0.6 1</ambient><diffuse>0.15 0.3 0.75 1</diffuse><specular>0.4 0.5 0.9 1</specular></material>
    </visual>
    <!-- GPS M9N mast -->
    <visual name="gps_mast">
      <pose>-0.04 0 0.038 0 0 0</pose>
      <geometry><cylinder><radius>0.006</radius><length>0.028</length></cylinder></geometry>
      <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
    </visual>
    <visual name="gps_dome">
      <pose>-0.04 0 0.060 0 0 0</pose>
      <geometry><sphere><radius>0.015</radius></sphere></geometry>
      <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.7 0.7 0.7 1</specular></material>
    </visual>
    <!-- ESC stack -->
    <visual name="esc_stack">
      <pose>0 0 -0.022 0 0 0</pose>
      <geometry><cylinder><radius>0.042</radius><length>0.014</length></cylinder></geometry>
      <material><ambient>0.05 0.15 0.05 1</ambient><diffuse>0.08 0.22 0.08 1</diffuse><specular>0.2 0.5 0.2 1</specular></material>
    </visual>
    <!-- Batterie 4S 5100 mAh -->
    <visual name="battery">
      <pose>0 0 -0.050 0 0 0</pose>
      <geometry><box><size>0.140 0.046 0.034</size></box></geometry>
      <material><ambient>0.1 0.35 0.1 1</ambient><diffuse>0.15 0.50 0.15 1</diffuse></material>
    </visual>

    <!-- ─── TRAIN D'ATTERRISSAGE ─────────────────────────────────── -->
    <visual name="leg_FR">
      <pose>0.090 -0.090 -0.100 0 0.42 -0.7854</pose>
      <geometry><cylinder><radius>0.008</radius><length>0.185</length></cylinder></geometry>
      <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
    </visual>
    <visual name="leg_FL">
      <pose>0.090 0.090 -0.100 0 0.42 0.7854</pose>
      <geometry><cylinder><radius>0.008</radius><length>0.185</length></cylinder></geometry>
      <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
    </visual>
    <visual name="leg_RR">
      <pose>-0.090 -0.090 -0.100 0 0.42 0.7854</pose>
      <geometry><cylinder><radius>0.008</radius><length>0.185</length></cylinder></geometry>
      <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
    </visual>
    <visual name="leg_RL">
      <pose>-0.090 0.090 -0.100 0 0.42 -0.7854</pose>
      <geometry><cylinder><radius>0.008</radius><length>0.185</length></cylinder></geometry>
      <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
    </visual>
    <visual name="skid_front">
      <pose>0.100 0 -0.178 0 0 1.5708</pose>
      <geometry><cylinder><radius>0.008</radius><length>0.220</length></cylinder></geometry>
      <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
    </visual>
    <visual name="skid_rear">
      <pose>-0.100 0 -0.178 0 0 1.5708</pose>
      <geometry><cylinder><radius>0.008</radius><length>0.220</length></cylinder></geometry>
      <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
    </visual>

    <!-- ─── LEDs de navigation ───────────────────────────────────── -->
    <visual name="led_front">
      <pose>0.085 0 -0.012 0 0 0</pose>
      <geometry><sphere><radius>0.007</radius></sphere></geometry>
      <material>
        <ambient>1.0 0.1 0.1 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse>
        <emissive>0.9 0.0 0.0 1</emissive>
      </material>
    </visual>
    <visual name="led_rear">
      <pose>-0.085 0 -0.012 0 0 0</pose>
      <geometry><sphere><radius>0.007</radius></sphere></geometry>
      <material>
        <ambient>0.1 1.0 0.1 1</ambient><diffuse>0.2 1.0 0.2 1</diffuse>
        <emissive>0.0 0.9 0.0 1</emissive>
      </material>
    </visual>

    <!-- ═══════════════════════════════════════════════════════════
         CAPTEURS EMBARQUÉS — lus par PX4 via gz-transport
         ═══════════════════════════════════════════════════════════ -->

    <!-- IMU – obligatoire pour EKF2 PX4 -->
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>250</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>

    <!-- GPS (NavSat) – obligatoire pour positionnement global PX4 -->
    <sensor name="navsat_sensor" type="navsat">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <navsat>
        <position_sensing>
          <horizontal><noise type="gaussian"><mean>0</mean><stddev>0.5</stddev></noise></horizontal>
          <vertical><noise type="gaussian"><mean>0</mean><stddev>0.8</stddev></noise></vertical>
        </position_sensing>
        <velocity_sensing>
          <horizontal><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></horizontal>
          <vertical><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></vertical>
        </velocity_sensing>
      </navsat>
    </sensor>

    <!-- Baromètre – altitude barométrique pour PX4 -->
    <sensor name="air_pressure_sensor" type="air_pressure">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <air_pressure>
        <reference_altitude>0</reference_altitude>
        <pressure><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></pressure>
      </air_pressure>
    </sensor>

  </link>

  <!-- ═══════════════════════════════════════════════════════════════
       ROTORS (4×) — liens séparés avec joints révolutifs
       Chaque rotor a son propre lien masse + joint + plugin moteur.
       Positions (±0.175m XY, z=0.023m au-dessus du centre).
       ═══════════════════════════════════════════════════════════════ -->

  <!-- ── ROTOR 0 : Avant-Droit (FR) — CCW ──────────────────────── -->
  <link name="rotor_0">
    <pose>0.175 -0.175 0.059 0 0 0</pose>
    <inertial>
      <mass>0.005</mass>
      <inertia><ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz></inertia>
    </inertial>
    <collision name="rotor_0_collision">
      <pose>0 0 0 0 0 0</pose>
      <geometry><cylinder><radius>0.127</radius><length>0.005</length></cylinder></geometry>
    </collision>
    <visual name="rotor_0_visual">
      <pose>0 0 0 0 0 0</pose>
      <geometry><cylinder><radius>0.127</radius><length>0.005</length></cylinder></geometry>
      <material>
        <ambient>0.55 0.09 0.09 0.7</ambient>
        <diffuse>0.70 0.11 0.11 0.7</diffuse>
      </material>
    </visual>
  </link>
  <joint name="rotor_0_joint" type="revolute">
    <child>rotor_0</child><parent>base_link</parent>
    <axis>
      <xyz expressed_in="__model__">0 0 1</xyz>
      <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      <dynamics><damping>0.004</damping></dynamics>
    </axis>
    <pose>0.175 -0.175 0.059 0 0 0</pose>
  </joint>

  <!-- ── ROTOR 1 : Arrière-Gauche (RL) — CCW ───────────────────── -->
  <link name="rotor_1">
    <pose>-0.175 0.175 0.059 0 0 0</pose>
    <inertial>
      <mass>0.005</mass>
      <inertia><ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz></inertia>
    </inertial>
    <collision name="rotor_1_collision">
      <pose>0 0 0 0 0 0</pose>
      <geometry><cylinder><radius>0.127</radius><length>0.005</length></cylinder></geometry>
    </collision>
    <visual name="rotor_1_visual">
      <pose>0 0 0 0 0 0</pose>
      <geometry><cylinder><radius>0.127</radius><length>0.005</length></cylinder></geometry>
      <material>
        <ambient>0.55 0.09 0.09 0.7</ambient>
        <diffuse>0.70 0.11 0.11 0.7</diffuse>
      </material>
    </visual>
  </link>
  <joint name="rotor_1_joint" type="revolute">
    <child>rotor_1</child><parent>base_link</parent>
    <axis>
      <xyz expressed_in="__model__">0 0 1</xyz>
      <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      <dynamics><damping>0.004</damping></dynamics>
    </axis>
    <pose>-0.175 0.175 0.059 0 0 0</pose>
  </joint>

  <!-- ── ROTOR 2 : Avant-Gauche (FL) — CW ──────────────────────── -->
  <link name="rotor_2">
    <pose>0.175 0.175 0.059 0 0 0</pose>
    <inertial>
      <mass>0.005</mass>
      <inertia><ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz></inertia>
    </inertial>
    <collision name="rotor_2_collision">
      <pose>0 0 0 0 0 0</pose>
      <geometry><cylinder><radius>0.127</radius><length>0.005</length></cylinder></geometry>
    </collision>
    <visual name="rotor_2_visual">
      <pose>0 0 0 0 0 0</pose>
      <geometry><cylinder><radius>0.127</radius><length>0.005</length></cylinder></geometry>
      <material>
        <ambient>0.20 0.20 0.20 0.7</ambient>
        <diffuse>0.28 0.28 0.28 0.7</diffuse>
      </material>
    </visual>
  </link>
  <joint name="rotor_2_joint" type="revolute">
    <child>rotor_2</child><parent>base_link</parent>
    <axis>
      <xyz expressed_in="__model__">0 0 1</xyz>
      <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      <dynamics><damping>0.004</damping></dynamics>
    </axis>
    <pose>0.175 0.175 0.059 0 0 0</pose>
  </joint>

  <!-- ── ROTOR 3 : Arrière-Droit (RR) — CW ─────────────────────── -->
  <link name="rotor_3">
    <pose>-0.175 -0.175 0.059 0 0 0</pose>
    <inertial>
      <mass>0.005</mass>
      <inertia><ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz></inertia>
    </inertial>
    <collision name="rotor_3_collision">
      <pose>0 0 0 0 0 0</pose>
      <geometry><cylinder><radius>0.127</radius><length>0.005</length></cylinder></geometry>
    </collision>
    <visual name="rotor_3_visual">
      <pose>0 0 0 0 0 0</pose>
      <geometry><cylinder><radius>0.127</radius><length>0.005</length></cylinder></geometry>
      <material>
        <ambient>0.20 0.20 0.20 0.7</ambient>
        <diffuse>0.28 0.28 0.28 0.7</diffuse>
      </material>
    </visual>
  </link>
  <joint name="rotor_3_joint" type="revolute">
    <child>rotor_3</child><parent>base_link</parent>
    <axis>
      <xyz expressed_in="__model__">0 0 1</xyz>
      <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      <dynamics><damping>0.004</damping></dynamics>
    </axis>
    <pose>-0.175 -0.175 0.059 0 0 0</pose>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════
       PLUGINS PHYSIQUE — MulticopterMotorModel (PX4 gz-transport)
       PX4 publie sur /model/{name}/command/motor_speed (Actuators msg)
       Chaque plugin applique forces/couples réalistes sur les liens.
       ═══════════════════════════════════════════════════════════════ -->

  <!-- MOTEUR 0 : Avant-Droit (CCW) -->
  <plugin filename="gz-sim-multicopter-motor-model-system"
          name="gz::sim::systems::MulticopterMotorModel">
    <robotNamespace>x500</robotNamespace>
    <jointName>rotor_0_joint</jointName>
    <linkName>rotor_0</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.0182</timeConstantUp>
    <timeConstantDown>0.0182</timeConstantDown>
    <maxRotorVelocity>1000</maxRotorVelocity>
    <motorConstant>8.54858e-06</motorConstant>
    <momentConstant>0.016754</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <motorNumber>0</motorNumber>
    <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
  </plugin>

  <!-- MOTEUR 1 : Arrière-Gauche (CCW) -->
  <plugin filename="gz-sim-multicopter-motor-model-system"
          name="gz::sim::systems::MulticopterMotorModel">
    <robotNamespace>x500</robotNamespace>
    <jointName>rotor_1_joint</jointName>
    <linkName>rotor_1</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.0182</timeConstantUp>
    <timeConstantDown>0.0182</timeConstantDown>
    <maxRotorVelocity>1000</maxRotorVelocity>
    <motorConstant>8.54858e-06</motorConstant>
    <momentConstant>0.016754</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <motorNumber>1</motorNumber>
    <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
  </plugin>

  <!-- MOTEUR 2 : Avant-Gauche (CW) -->
  <plugin filename="gz-sim-multicopter-motor-model-system"
          name="gz::sim::systems::MulticopterMotorModel">
    <robotNamespace>x500</robotNamespace>
    <jointName>rotor_2_joint</jointName>
    <linkName>rotor_2</linkName>
    <turningDirection>cw</turningDirection>
    <timeConstantUp>0.0182</timeConstantUp>
    <timeConstantDown>0.0182</timeConstantDown>
    <maxRotorVelocity>1000</maxRotorVelocity>
    <motorConstant>8.54858e-06</motorConstant>
    <momentConstant>0.016754</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <motorNumber>2</motorNumber>
    <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
  </plugin>

  <!-- MOTEUR 3 : Arrière-Droit (CW) -->
  <plugin filename="gz-sim-multicopter-motor-model-system"
          name="gz::sim::systems::MulticopterMotorModel">
    <robotNamespace>x500</robotNamespace>
    <jointName>rotor_3_joint</jointName>
    <linkName>rotor_3</linkName>
    <turningDirection>cw</turningDirection>
    <timeConstantUp>0.0182</timeConstantUp>
    <timeConstantDown>0.0182</timeConstantDown>
    <maxRotorVelocity>1000</maxRotorVelocity>
    <motorConstant>8.54858e-06</motorConstant>
    <momentConstant>0.016754</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <motorNumber>3</motorNumber>
    <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
  </plugin>

  <!-- ═══════════════════════════════════════════════════════════════
       PUBLICATION POSE — retour position vers MAVROS / ROS2 bridge
       ═══════════════════════════════════════════════════════════════ -->
  <plugin filename="gz-sim-pose-publisher-system"
          name="gz::sim::systems::PosePublisher">
    <publish_link_pose>false</publish_link_pose>
    <publish_nested_model_pose>false</publish_nested_model_pose>
    <publish_model_pose>true</publish_model_pose>
    <update_frequency>50</update_frequency>
  </plugin>

</model>
</sdf>
