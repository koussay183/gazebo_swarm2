<?xml version="1.0"?>
<model>
  <name>x500</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Holybro x500 v2 quadrotor – modèle réel utilisé avec PX4 SITL.
    Wheelbase 500 mm, masse 2 kg, moteurs 2216 880 KV, hélices 10×4.5 pouces.
    Intègre MulticopterMotorModel (physique réelle) + capteurs IMU/GPS/Baro
    pour communication PX4 via gz-transport.
  </description>
</model>
